{
  "name": "custo3d-api",
  "version": "1.0.0",
  "description": "API da calculadora de custo de impressão 3D (carretéis, materiais, equipamentos e impressões)",
  "main": "dist/server.js",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch server.ts",
    "build": "tsc --noEmit -p tsconfig.build.json && esbuild src/main.ts --bundle --platform=node --format=esm --packages=external --target=es2022 --outfile=dist/server.js",
    "start": "node dist/server.js",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --fix",
    "db:check": "tsx src/scripts/checkDb.ts"
  },
  "author": "Guilherme Amaral",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.10.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.17.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0"
  }
}
